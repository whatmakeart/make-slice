{
  "name": "makeslice-standalone",
  "version": "2.4.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.15.0"
  },
  "scripts": {
    "dev": "vite --config vite.portable.config.ts",
    "build": "node scripts/build-portable.mjs",
    "preview": "vite preview --config vite.portable.config.ts",
    "check": "tsc --noEmit",
    "test": "node --import tsx tests/geometry.ts && node --import tsx tests/preview-geometry.ts && node --import tsx tests/material-pins.ts && node --import tsx tests/fabrication.ts && node --import tsx tests/shell-materials.ts && node --import tsx tests/nesting-guide.ts && node --import tsx tests/contour-bands.ts && node --import tsx tests/preferences.ts && node --import tsx tests/workspace.tsx && node tests/portable.mjs",
    "test:performance": "node --import tsx tests/performance.ts",
    "test:browser": "node tests/native-browser.cjs",
    "test:enhancements": "node tests/native-enhancements.cjs",
    "package": "npm run build && node scripts/package-distribution.mjs"
  },
  "dependencies": {
    "class-variance-authority": "0.7.1",
    "clipper-lib": "6.4.2",
    "clsx": "2.1.1",
    "fflate": "0.8.3",
    "lucide-react": "1.31.0",
    "radix-ui": "1.6.7",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "3.6.0",
    "three": "0.186.1",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/clipper-lib": "6.4.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.0.2",
    "jsdom": "30.1.1",
    "playwright": "^1.64.0",
    "tailwindcss": "4.2.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "^8.3.4"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  }
}
